NODE_ENV=production
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@postgres:5432/used_car

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT — replace with strong, randomly-generated secrets ────────────────────
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay (live keys) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Mailer ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://your-production-domain.com
CORS_ORIGINS=https://your-production-domain.com

LOG_LEVEL=info

DB_POOL_MAX=20
DB_POOL_MIN=5
